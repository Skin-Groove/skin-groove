{
	"ignoreDependencies": [
		// CSS imports these font files with url(), and fallow reads only JS imports.
		"@fontsource-variable/manrope",
		"@fontsource/caprasimo",
		"@fontsource/dm-serif-display",
		"@fontsource/righteous",
		// The production build needs these, so they stay in dependencies. fallow
		// counts astro.config.ts as a dev file.
		"@tailwindcss/vite",
		"@varlock/astro-integration",
		"astro",
	],
}
