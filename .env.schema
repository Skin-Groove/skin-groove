# Local values live in .env.local, encrypted with `varlock encrypt`.
# Production values live in Railway service variables.
#
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts)
# ---

# Railway sets this to production. CI sets this to test.
# @type=enum(development, test, production) @public
APP_ENV=development

# ===== Porkbun =====
# Skin Groove account. Local DNS tooling only; the app does not read it.
# @type=string(startsWith=pk1_)
# @docs(https://porkbun.com/api/json/v3/documentation)
PORKBUN_API_KEY=

# @type=string(startsWith=sk1_)
PORKBUN_SECRET_KEY=

# ===== Cal.com =====
# Not set up yet. Signs the MEETING_ENDED and BOOKING_NO_SHOW_UPDATED webhooks
# that schedule discount codes. Cal.com's Stripe app takes payments and
# refunds, so the app needs no Stripe keys.
# @docs(https://cal.com/docs/developing/guides/automation/webhooks)
CALCOM_WEBHOOK_SECRET=

# ===== Shopify =====
# Not set up yet.
# @type=string(matches=regex("^[a-z0-9-]+\.myshopify\.com$")) @public
# @example="skin-groove.myshopify.com"
SHOPIFY_STORE_DOMAIN=

# Private Storefront API token. Reads products and builds carts server-side.
# @docs(https://shopify.dev/docs/api/usage/authentication#getting-started-with-private-access)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Creates discount codes.
# @type=string(startsWith=shpat_)
# @docs(https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/generate-app-access-tokens-admin)
SHOPIFY_ADMIN_ACCESS_TOKEN=
