---
// Page CSS overrides these rules at equal specificity, so they load first here.
import '@/styles/global.css'
import '@/components/site/base.css'
import '@/components/site/site.css'

interface Props {
	title?: string
	description?: string
	ogTitle?: string
	/** Sets the canonical URL. PR environments point at production on purpose. */
	canonicalPath?: string
}

const {
	title = 'Skin Groove | Virtual Esthetics',
	description = 'Thoughtful, curated skincare guidance to help you understand your skin, simplify your routine, and finally find what works for you.',
	ogTitle = 'Skin Groove',
	canonicalPath,
} = Astro.props

const canonicalUrl = canonicalPath && new URL(canonicalPath, Astro.site).href
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta
			property="og:image"
			content={new URL('/images/og.jpg', Astro.site).href}
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#08140f" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{canonicalUrl && (
			<>
				<meta property="og:url" content={canonicalUrl} />
				<link rel="canonical" href={canonicalUrl} />
			</>
		)}
	</head>
	<body>
		<slot />
	</body>
</html>
