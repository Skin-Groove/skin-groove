---
import Bloom from './bloom.astro'
import { fill, uniqueId } from './tones'

const topId = uniqueId()

const bottomId = uniqueId()

const grooves = Array.from({ length: 9 }, (_, i) => 176 - i * 9)
---

<svg aria-hidden="true" viewBox="0 0 400 400">
	<defs>
		<path d="M 134 200 A 66 66 0 0 1 266 200" id={topId}></path>
		<path d="M 125 200 A 75 75 0 0 0 275 200" id={bottomId}></path>
	</defs>
	<circle class={fill.vinyl} cx="200" cy="200" r="194"></circle>
	{grooves.map((radius) => (
		<circle
			class="lg-groove"
			cx="200"
			cy="200"
			fill="none"
			r={radius}
			stroke-width="1.5"
		/>
	))}
	<path class="lg-sheen" d="M200 200 L 330 40 A 194 194 0 0 1 375 95 Z"></path>
	<path class="lg-sheen" d="M200 200 L 70 360 A 194 194 0 0 1 25 305 Z"></path>
	<circle class={fill.amber} cx="200" cy="200" r="86"></circle>
	<Bloom center="garnet" petal={['burnt']} r={40} x={200} y={200} />
	<text
		class="lg-label-text"
		font-size="13"
		font-weight="800"
		letter-spacing="3"
		text-anchor="middle"
	>
		<textPath href={'#' + topId} startOffset="50%">
			SKIN GROOVE
		</textPath>
	</text>
	<text
		class="lg-label-text"
		font-size="10"
		font-weight="800"
		letter-spacing="2.5"
		text-anchor="middle"
	>
		<textPath href={'#' + bottomId} startOffset="50%">
			VIRTUAL ESTHETICS
		</textPath>
	</text>
</svg>
