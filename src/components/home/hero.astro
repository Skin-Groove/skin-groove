---
import BookPill from '@/components/site/book-pill.astro'
import Icon from '@/components/site/icon.astro'
import SiteNav from '@/components/site/site-nav.astro'
import Wave from '@/components/site/wave.astro'

import { wavyOutlinePath } from './wavy-outline'

import './hero.css'

const mirror = { width: 600, height: 800 }

const outline = wavyOutlinePath({ ...mirror, amplitude: 16, waves: 10 })

// A stroke paints half its width past the outline. The bands stack widest first, so each band shows as one flat ring.
const ripples = [
	{ color: 'var(--garnet)', width: 1000 },
	{ color: 'var(--rust)', width: 760 },
	{ color: 'var(--burnt)', width: 530 },
	{ color: 'var(--amber)', width: 300 },
	{ color: 'var(--apricot)', width: 150 },
	{ color: 'var(--cream)', width: 26 },
]

const scallopAngles = Array.from({ length: 16 }, (_, index) => index * 22.5)
---

<header class="hero">
	<SiteNav />

	<div class="hero-copy">
		<h1>
			<span class="hero-eyebrow">Skin Groove · Virtual esthetics</span>
			<span class="hero-title">Find your skincare rhythm.</span>
		</h1>
		<p class="hero-lead">
			Thoughtful, curated skincare guidance to help you understand your skin,
			simplify your routine, and finally find what works for you.
		</p>
		<div class="hero-actions">
			<BookPill />
			<a class="gv-text-link" href="#services">
				See the services
				<Icon name="arrowRight" />
			</a>
		</div>
	</div>

	<figure class="hero-mirror">
		<svg
			aria-hidden="true"
			class="hero-ripples"
			viewBox={`0 0 ${mirror.width} ${mirror.height}`}
		>
			<defs>
				<path d={outline} id="hero-outline"></path>
				<clipPath clipPathUnits="objectBoundingBox" id="hero-mirror-clip">
					<path
						d={outline}
						transform={`scale(${1 / mirror.width} ${1 / mirror.height})`}
					></path>
				</clipPath>
			</defs>
			{ripples.map((ripple, index) => (
				<use
					fill="none"
					href="#hero-outline"
					stroke={ripple.color}
					stroke-width={ripple.width}
					style={`--ripple:${ripples.length - index}`}
				/>
			))}
		</svg>
		<img
			alt="Sammy, the founder of Skin Groove, smiling in a black uniform"
			fetchpriority="high"
			height={1080}
			src="/images/sammy.webp"
			width={810}
		/>
		<figcaption>Sammy · Esthetician and cosmetologist</figcaption>
		<p class="sr-only">$50 shop credit with every consult.</p>
		<div aria-hidden="true" class="hero-sticker">
			<svg viewBox="0 0 100 100">
				<circle cx="50" cy="50" r="40"></circle>
				{scallopAngles.map((angle) => (
					<circle cx="50" cy="9.5" r="9" transform={`rotate(${angle} 50 50)`} />
				))}
			</svg>
			<p>
				$50<span>shop credit</span>
			</p>
		</div>
	</figure>

	<Wave class="hero-wave" />
</header>
