---
import Icon from '@/components/site/icon.astro'

interface Props {
	questions: readonly { question: string; answer: string }[]
}

const { questions } = Astro.props
---

<div class="gv-faq">
	{questions.map((item) => (
		<details>
			<summary>
				{item.question}
				<Icon name="plus" />
			</summary>
			<p set:html={item.answer} />
		</details>
	))}
</div>
