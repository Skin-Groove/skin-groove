---
import SiteNav from '@/components/site/site-nav.astro'

import { policyUpdated } from './content'

import './privacy.css'

interface Props {
	title: string
}

const { title } = Astro.props
---

<header class="privacy-hero">
	<SiteNav />
	<div class="privacy-hero-inner">
		<p class="gv-kicker">Skin Groove LLC</p>
		<h1>{title}</h1>
		<p>Last updated {policyUpdated}</p>
	</div>
</header>
