---
import { cn } from '@/lib/utils/ui'

interface Props {
	class?: string
}

const { class: className } = Astro.props

const { pathname } = Astro.url
---

<div class={cn('gv-links', className)}>
	<a aria-current={pathname === '/about' ? 'page' : undefined} href="/about">
		About
	</a>
	<a href="/#services">Services</a>
	<a href="/#faq">FAQ</a>
	<a href="#contact">Contact</a>
</div>
