---
import { cn } from '@/lib/utils/ui'

interface Props {
	class?: string
}

const { class: className } = Astro.props

const petalAngles = [0, 72, 144, 216, 288]
---

<!-- A spinning vinyl record with a flower label. The label takes the current text color. -->
<svg
	aria-hidden="true"
	class={cn('gv-record', className)}
	viewBox="0 0 100 100"
>
	<circle class="gv-record-vinyl" cx="50" cy="50" r="48"></circle>
	<circle class="gv-record-rim" cx="50" cy="50" r="47.5"></circle>
	{[42, 37, 32, 27].map((radius) => (
		<circle class="gv-record-groove" cx="50" cy="50" r={radius} />
	))}
	<path class="gv-record-sheen" d="M50 50 L84 16 A48 48 0 0 1 96 34 Z"></path>
	<path class="gv-record-sheen" d="M50 50 L16 84 A48 48 0 0 1 4 66 Z"></path>
	<circle class="gv-record-label" cx="50" cy="50" r="19"></circle>
	{petalAngles.map((angle) => (
		<circle
			class="gv-record-vinyl"
			cx="50"
			cy="41"
			r="6.5"
			transform={`rotate(${angle} 50 50)`}
		/>
	))}
	<circle class="gv-record-label" cx="50" cy="50" r="3.5"></circle>
</svg>
