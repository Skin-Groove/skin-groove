{
	"name": "skin-by-smintz",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"start": "varlock run -- node .output/server/index.mjs",
		"check": "vp check",
		"test": "vp test run --passWithNoTests",
		"test:unit": "vp test run --project unit --passWithNoTests",
		"test:visual": "playwright test --grep @visual --retries=0 --update-snapshots=none",
		"test:visual:record": "playwright test --grep @visual --retries=0 --update-snapshots=all",
		"test:watch": "vp test --watch",
		"e2e": "playwright test --grep-invert @visual",
		"report": "playwright show-report .playwright/report",
		"prepare": "vp config --hooks-only",
		"update-pnpm": "corepack use pnpm@11",
		"dead-code": "fallow dead-code"
	},
	"dependencies": {
		"@calcom/embed-react": "1.5.3",
